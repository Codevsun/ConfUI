{
  "general": {
    "mode": "production",
    "debug": false
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "workers": 4
  },
  "database": {
    "name": "myapp",
    "user": "admin",
    "password": "s3cret",
    "pool_size": 20
  },
  "logging": {
    "level": "info",
    "file": "/var/log/myapp.log",
    "max_size": 10485760
  },
  "features": {
    "enable_notifications": true,
    "enable_analytics": false,
    "maintenance_mode": false
  },
  "limits": {
    "max_connections": 100,
    "timeout_seconds": 30,
    "retry_attempts": 3
  },
  "api": {
    "version": "v2",
    "rate_limit": 1000,
    "endpoints": ["users", "posts", "comments", "tags"]
  },
  "theme": {
    "primary_color": "#3366FF",
    "dark_mode": true,
    "font_size": 14
  },
  "null_values": {
    "description": null,
    "alternative": null
  }
}
